diff --git a/js/ui/search.js b/js/ui/search.js
index 88965bf..7134934 100644
--- a/js/ui/search.js
+++ b/js/ui/search.js
@@ -66,7 +66,7 @@ class SearchResult extends St.Button {
             St.Clipboard.get_default().set_text(
                 St.ClipboardType.CLIPBOARD, this.metaInfo.clipboardText);
         }
-        Main.overview.toggle();
+        this._resultsView.onActivated();
     }
 });
 
@@ -194,7 +194,7 @@ const SearchResultsBase = GObject.registerClass({
     }
 
     _createResultDisplay(meta) {
-        if (this.provider.createResultObject)
+        if (!this._resultsView.listResults && this.provider.createResultObject)
             return this.provider.createResultObject(meta);
 
         return null;
@@ -298,15 +298,17 @@ class ListSearchResults extends SearchResultsBase {
             style_class: 'search-section-content',
             x_expand: true,
         });
-        this.providerInfo = new ProviderInfo(provider);
-        this.providerInfo.connect('key-focus-in', this._keyFocusIn.bind(this));
-        this.providerInfo.connect('clicked', () => {
-            this.providerInfo.animateLaunch();
-            provider.launchSearch(this._terms);
-            Main.overview.toggle();
-        });
+        this.providerInfo = provider.appInfo ? new ProviderInfo(provider) : null;
+        if (this.providerInfo) {
+            this.providerInfo.connect('key-focus-in', this._keyFocusIn.bind(this));
+            this.providerInfo.connect('clicked', () => {
+                this.providerInfo.animateLaunch();
+                provider.launchSearch(this._terms);
+                this._resultsView.onActivated();
+            });
 
-        this._container.add_child(this.providerInfo);
+            this._container.add_child(this.providerInfo);
+        }
 
         this._content = new St.BoxLayout({
             style_class: 'list-search-results',
@@ -319,7 +321,7 @@ class ListSearchResults extends SearchResultsBase {
     }
 
     _setMoreCount(count) {
-        this.providerInfo.setMoreCount(count);
+        this.providerInfo?.setMoreCount(count);
     }
 
     _getMaxDisplayedResults() {
@@ -567,7 +569,8 @@ class GridSearchResults extends SearchResultsBase {
 export const SearchResultsView = GObject.registerClass({
     Signals: {'terms-changed': {}},
 }, class SearchResultsView extends St.BoxLayout {
-    _init() {
+    _init({appProvider = new AppDisplay.AppSearchProvider(),
+        listResults = false, onActivated = () => Main.overview.toggle()} = {}) {
         super._init({
             name: 'searchResults',
             orientation: Clutter.Orientation.VERTICAL,
@@ -575,6 +578,10 @@ export const SearchResultsView = GObject.registerClass({
             y_expand: true,
         });
 
+        // The overview keeps its existing icons and activation lifecycle.
+        this.listResults = listResults;
+        this.onActivated = onActivated;
+
         this._parentalControlsManager = ParentalControlsManager.getDefault();
         this._parentalControlsManager.connect('app-filter-changed', this._reloadRemoteProviders.bind(this));
 
@@ -636,7 +643,7 @@ export const SearchResultsView = GObject.registerClass({
         this._searchTimeoutId = 0;
         this._cancellable = new Gio.Cancellable();
 
-        this._registerProvider(new AppDisplay.AppSearchProvider());
+        this._registerProvider(appProvider);
 
         const appSystem = Shell.AppSystem.get_default();
         appSystem.connect('installed-changed', this._reloadRemoteProviders.bind(this));
@@ -690,6 +697,7 @@ export const SearchResultsView = GObject.registerClass({
         this._terms = [];
         this._results = {};
         this._clearDisplay();
+        this._providers.forEach(provider => (provider.searchInProgress = false));
         this._clearSearchTimeout();
         this._defaultResult = null;
         this._startingSearch = false;
@@ -702,6 +710,7 @@ export const SearchResultsView = GObject.registerClass({
 
         let results = [];
         const terms = this._terms;
+        const cancellable = this._cancellable;
         try {
             if (this._isSubSearch && previousResults) {
                 results = await provider.getSubsearchResultSet(
@@ -714,8 +723,11 @@ export const SearchResultsView = GObject.registerClass({
                     this._cancellable);
             }
         } finally {
-            this._results[provider.id] = results;
-            await this._updateResults(provider, terms, results);
+            // A popup may reset its search while a provider is still replying.
+            if (!cancellable.is_cancelled() && this._providers.includes(provider)) {
+                this._results[provider.id] = results;
+                await this._updateResults(provider, terms, results);
+            }
         }
     }
 
@@ -793,7 +805,7 @@ export const SearchResultsView = GObject.registerClass({
             return;
 
         let providerDisplay;
-        if (provider.appInfo)
+        if (provider.appInfo || this.listResults)
             providerDisplay = new ListSearchResults(provider, this);
         else
             providerDisplay = new GridSearchResults(provider, this);
