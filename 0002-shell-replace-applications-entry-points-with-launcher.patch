From dab04c82197c6e60f2764915673dfe8a6dc783b0 Mon Sep 17 00:00:00 2001
From: Downstream Maintainer <downstream@example.invalid>
Date: Sun, 2 Aug 2026 17:23:45 +0000
Subject: [PATCH] shell: replace applications entry points with launcher

Route overlay-key, Super+A and Show Apps to a compact launcher. Preserve
overview states and workspace gestures. Let SearchResultsView support
list rows and a caller-owned activation lifecycle.

The new launcher module and Sass are supplied separately as Source100.
Based on upstream dcda6594b153aa179d92cc62e2414d84a43ab82c.
---
 data/theme/gnome-shell-sass/_widgets.scss |  2 ++
 data/theme/meson.build                    |  1 +
 js/js-resources.gresource.xml             |  1 +
 js/ui/dash.js                             |  3 +-
 js/ui/main.js                             |  4 +++
 js/ui/overview.js                         |  2 ++
 js/ui/overviewControls.js                 | 24 ++-----------
 js/ui/search.js                           | 44 ++++++++++++++---------
 8 files changed, 42 insertions(+), 39 deletions(-)

diff --git a/data/theme/gnome-shell-sass/_widgets.scss b/data/theme/gnome-shell-sass/_widgets.scss
index 9eac62d..0fdfe39 100644
--- a/data/theme/gnome-shell-sass/_widgets.scss
+++ b/data/theme/gnome-shell-sass/_widgets.scss
@@ -47,3 +47,5 @@
 @import 'widgets/looking-glass';
 // Lock / login screen
 @import 'widgets/login-lock';
+
+@import 'widgets/launcher';
diff --git a/data/theme/meson.build b/data/theme/meson.build
index 8d01ae8..d2beb98 100644
--- a/data/theme/meson.build
+++ b/data/theme/meson.build
@@ -19,6 +19,7 @@ theme_sources = files([
   'gnome-shell-sass/widgets/_entries.scss',
   'gnome-shell-sass/widgets/_ibus-popup.scss',
   'gnome-shell-sass/widgets/_keyboard.scss',
+  'gnome-shell-sass/widgets/_launcher.scss',
   'gnome-shell-sass/widgets/_login-lock.scss',
   'gnome-shell-sass/widgets/_looking-glass.scss',
   'gnome-shell-sass/widgets/_message-list.scss',
diff --git a/js/js-resources.gresource.xml b/js/js-resources.gresource.xml
index e5e6167..59a4690 100644
--- a/js/js-resources.gresource.xml
+++ b/js/js-resources.gresource.xml
@@ -78,6 +78,7 @@
     <file>ui/kbdA11yDialog.js</file>
     <file>ui/keyboard.js</file>
     <file>ui/layout.js</file>
+    <file>ui/launcher.js</file>
     <file>ui/lightbox.js</file>
     <file>ui/listModes.js</file>
     <file>ui/locatePointer.js</file>
diff --git a/js/ui/dash.js b/js/ui/dash.js
index 970bf94..505dd20 100644
--- a/js/ui/dash.js
+++ b/js/ui/dash.js
@@ -194,7 +194,7 @@ class ShowAppsIcon extends DashItemContainer {
             style_class: 'show-apps',
             track_hover: true,
             can_focus: true,
-            toggle_mode: true,
+            toggle_mode: false,
         });
         this._iconActor = null;
         this.icon = new IconGrid.BaseIcon(_('Show Apps'), {
@@ -206,6 +206,7 @@ class ShowAppsIcon extends DashItemContainer {
 
